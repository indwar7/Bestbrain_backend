# Copy this file to .env and fill in your real values.
#
# LOCAL DEV: a .env file is fine.
# PRODUCTION HOSTING (Render / Railway / etc.): do NOT commit secrets to a file.
#   Set each of these as an environment variable in the host's dashboard instead.

# ---- Server ----
PORT=4000
NODE_ENV=development          # set to "production" when deployed

# ---- Database ----
# MongoDB Atlas connection string (get from https://cloud.mongodb.com).
# REQUIRED in production — without it the app uses a throwaway in-memory DB.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edulearn?retryWrites=true&w=majority

# ---- Auth (JWT) ----
# REQUIRED in production. Use two different long random strings, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL=15m
REFRESH_TTL=7d

# ---- PAL AI (Vertex AI / Gemini) ----
# Powers PAL chat, the voice doubt session, and the study-sheet generator.
#
# TWO things are required together. A credential on its own is not enough:
# Vertex cannot infer the project, so every call fails with "Unable to detect
# a Project" and the student sees a 503. The server now says so at startup
# rather than letting a half-configured deploy look healthy.
#
#   1. a credential  — GOOGLE_CREDENTIALS_JSON or GOOGLE_APPLICATION_CREDENTIALS
#   2. VERTEX_PROJECT — the GCP project id the credential is granted on
#
# (A) Hosting (recommended) — the whole service-account JSON as one env var.
#     No file needed; works on hosts with no persistent disk.
#
#     It MUST be on a SINGLE line. dotenv ends a value at the first newline,
#     so a pasted multi-line file arrives truncated and PAL fails with an
#     invalid-JSON error. Flatten it first:
#         jq -c . service-account.json
#     Keep the \n escapes inside private_key exactly as they are — those are
#     two characters in the JSON, not real line breaks.
GOOGLE_CREDENTIALS_JSON=
#
# (B) Local dev — a path to the service-account JSON file on disk.
#     Keep the file OUT of the repo; .gitignore covers the usual names.
GOOGLE_APPLICATION_CREDENTIALS=
#
# The project id the credential belongs to. Must match the "project_id" in the
# service-account JSON unless the key was deliberately granted on another
# project; startup warns when the two disagree, since that is usually a typo.
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
#
# The service account needs the Vertex AI User role (roles/aiplatform.user) on
# VERTEX_PROJECT, and that project needs the Vertex AI API enabled and billing
# active. Missing any of those surfaces as PERMISSION_DENIED or a billing
# error, which PAL reports as "not set up correctly" rather than as a glitch.
#
# If NEITHER credential is set, PAL returns a stub reply instead of failing —
# fine for local dev, never what you want in production.

# Optional legacy: Groq API key (unused now that PAL is on Gemini; leave empty).
GROQ_API_KEY=

# ---- Logging & error tracking ----
# LOG_LEVEL: trace|debug|info|warn|error|fatal (defaults: debug in dev, info in prod)
LOG_LEVEL=
# SENTRY_DSN: set to enable error tracking (see src/config/logger.ts for the
# 3-step wiring). Leave empty to log errors only.
SENTRY_DSN=

# ---- OTP / Verification ----
# Turn the login verification gate ON only after the frontend has a verify
# screen. The send-otp/verify-otp endpoints work regardless. Default: off.
OTP_ENFORCED=false
#
# Email provider (leave EMAIL_PROVIDER empty to log codes to the console in dev):
#   EMAIL_PROVIDER=resend   + RESEND_API_KEY
#   EMAIL_PROVIDER=sendgrid + SENDGRID_API_KEY
EMAIL_PROVIDER=
EMAIL_FROM=EduLearn <no-reply@edulearn.app>
RESEND_API_KEY=
SENDGRID_API_KEY=
#
# SMS provider (leave SMS_PROVIDER empty to log codes to the console in dev):
#   SMS_PROVIDER=msg91  + MSG91_AUTH_KEY, MSG91_TEMPLATE_ID, MSG91_SENDER
#   SMS_PROVIDER=twilio + TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=EDULRN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Admin ----
# Guards GET /api/admin/users (exposes user PII). Send it as the `x-admin-key`
# header or `?adminKey=`. If unset, the endpoint is blocked in production.
ADMIN_API_KEY=

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
#
# IN DEVELOPMENT (NODE_ENV != production) any localhost port is accepted, so
# this list barely matters locally — serve the frontend on whatever port suits.
#
# IN PRODUCTION this list is the ONLY thing accepted. That is deliberate: the
# frontend sends credentials:'include', so any origin added here can read a
# signed-in user's real data. Do NOT add localhost ports here to make local
# development against production data easier.
#
# If you DO need to point a local frontend at the production API, serve it from
# http://localhost:8000 — already on this list — rather than widening the list.
# Serving on any other port will be blocked by the browser, which surfaces as a
# misleading "Failed to fetch" rather than an explicit CORS error.
#
# https://bestbrainplus.com is the live site (Hostinger). Unlike the Vercel
# deployment, which proxies /backend-api/* to this API and is therefore
# same-origin, that host calls https://api.bestbrainplus.com directly — so it
# is a genuine cross-origin caller and must be listed here or every request
# fails CORS.
CLIENT_ORIGIN=http://localhost:8000,https://edulearn-platform-theta.vercel.app,https://bestbrainplus.com

# ---- LiveKit (live video) ----
# Get from https://cloud.livekit.io -> Project -> Settings -> Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-secret
