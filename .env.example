# Copy this file to .env and fill in your real values.
#
# LOCAL DEV: a .env file is fine.
# PRODUCTION HOSTING (Render / Railway / etc.): do NOT commit secrets to a file.
#   Set each of these as an environment variable in the host's dashboard instead.

# ---- Server ----
PORT=4000
NODE_ENV=development          # set to "production" when deployed

# ---- Database ----
# MongoDB Atlas connection string (get from https://cloud.mongodb.com).
# REQUIRED in production — without it the app uses a throwaway in-memory DB.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edulearn?retryWrites=true&w=majority

# ---- Auth (JWT) ----
# REQUIRED in production. Use two different long random strings, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL=15m
REFRESH_TTL=7d

# ---- PAL AI (Vertex AI / Gemini) ----
# Supply the service-account credentials ONE of two ways:
#
#  (A) Hosting (recommended) — paste the whole service-account JSON as a single
#      env var. No file needed; works on hosts with no persistent disk.
GOOGLE_CREDENTIALS_JSON=
#
#  (B) Local dev — point at the service-account JSON file on disk.
GOOGLE_APPLICATION_CREDENTIALS=
#
# If neither is set, PAL returns a stub reply instead of a real answer.
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# Optional legacy: Groq API key (unused now that PAL is on Gemini; leave empty).
GROQ_API_KEY=

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:8000,https://edulearn-platform-theta.vercel.app

# ---- LiveKit (live video) ----
# Get from https://cloud.livekit.io -> Project -> Settings -> Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-secret
