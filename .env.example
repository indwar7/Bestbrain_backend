# Copy this file to .env and fill in your real values

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edulearn?retryWrites=true&w=majority

# JWT secrets — use two different long random strings
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL=15m
REFRESH_TTL=7d

# Optional: Groq API key for PAL AI chat (leave empty to use a stub reply)
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:8000,https://edulearn-platform-theta.vercel.app
